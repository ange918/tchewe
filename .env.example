# Projet Supabase — valeurs à renseigner dans .env.local en développement,
# et dans les variables d'environnement Vercel pour les déploiements.
#
# La clé publiable est conçue pour être exposée au navigateur : elle n'accorde
# aucun droit par elle-même, la RLS décide de tout. Ne jamais mettre ici la
# clé de service (service_role), qui contourne la RLS.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
